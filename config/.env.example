# Optional desktop Telegram integration. Never put real tokens in source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTO_RECORD_ON_START=false
FACE_RECOGNITION_ENABLED=true
FACE_MATCH_THRESHOLD=0.6
FACE_ALERT_COOLDOWN=30

# Camera requests are best-effort; Motion Vision always reports delivered values.
CAMERA_INDEX=0
CAMERA_RESOLUTION=Auto
CAMERA_FPS=Auto
